{
  "permissions": {
    "allow": [
      "Bash(bash .github/scripts/verify-affected-modules.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-plugins.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-dagger.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "daggerverse@z5labs-devex": true,
    "backlog@z5labs-devex": true
  },
  "extraKnownMarketplaces": {
    "z5labs-devex": {
      "source": {
        "source": "github",
        "repo": "z5labs/devex"
      }
    }
  }
}
