meta {
  name: token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/token
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{process.env.API_TOKEN}}
  X-Custom: {{process.env.API_TOKEN}}
  X-Trace-Id: trace-abc123
}

body:json {
  {
    "credential": "{{process.env.API_TOKEN}}"
  }
}

assert {
  res.status: eq 200
}
