meta {
  name: token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/token
  body: none
  auth: none
}

headers {
  X-Token: {{process.env.API_TOKEN}}
}

script:pre-request {
  // The responder records this header, so the test can assert on the exact
  // command line bru itself was invoked with. That is the only way to prove a
  // secret never reached argv: --env-var would put it there, and nothing
  // outside the container can read a finished process's command line.
  req.setHeader("x-argv", process.argv.join(" "));
}

assert {
  res.status: eq 200
}
